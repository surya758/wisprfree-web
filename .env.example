# Stage 1 — speech to text. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Stage 2 — cleanup via Google Vertex AI. Optional: without it the demo
# returns the raw transcript, exactly like the Mac app with no provider set.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.6-flash

# Locally, authenticate with Application Default Credentials:
#   gcloud auth application-default login
#
# On Vercel there is no ADC. Create a service account with the
# "Vertex AI User" role, download its JSON key, and paste the whole
# document into this one variable.
GOOGLE_SERVICE_ACCOUNT_JSON=
